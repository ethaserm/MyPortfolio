---
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import Icon from './Icon.astro';
import type { Category } from '../lib/categories';

// The picture for a project, in one of three treatments:
//  - a screenshot, with a soft corner wash of the theme colours
//  - a phone (portrait) screenshot, shown on a coloured panel
//  - no image yet: a designed panel with the area's icon, so nothing is ever blank
interface Props {
  cover?: ImageMetadata;
  category: Category;
  size?: 'card' | 'large';
}

const { cover, category, size = 'card' } = Astro.props;
const portrait = cover ? cover.height > cover.width : false;
const kind = !cover ? 'gen' : portrait ? 'phone' : 'shot-cover';
---

<div class:list={['cover', kind, { 'cover-lg': size === 'large' }]}>
  {cover
    ? <Image src={cover} alt="" width={portrait ? 600 : size === 'large' ? 1200 : 800} />
    : <Icon name={category} size={58} />}
</div>
