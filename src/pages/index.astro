---
import Base from '../layouts/Base.astro';
import ProjectCard from '../components/ProjectCard.astro';
import TimelineEntry from '../components/TimelineEntry.astro';
import Stats from '../components/Stats.astro';
import { site } from '../data/site';
import { getProjects, getTimeline } from '../lib/content';
import { url } from '../lib/url';

const projects = await getProjects();

// Featured projects if any are marked, otherwise just the newest few.
const featured = projects.filter((p) => p.data.featured).slice(0, 6);
const showcase = featured.length > 0 ? featured : projects.slice(0, 4);
const latest = (await getTimeline()).slice(0, 4);
const newest = projects[0];
const initial = site.name.trim().charAt(0).toUpperCase() || '·';
const github = site.links.find((l) => /github/i.test(l.href));
---

<Base>
  <section class="tab-hero">
    <span class="avatar" aria-hidden="true">{initial}</span>
    {site.now && <p class="now">Now: {site.now}</p>}
    <h1>{site.name}</h1>
    <p class="lede">{site.tagline}</p>
    <div class="hero-btns">
      {newest && <a class="btn-main" href={url(`/projects/${newest.id}`)}>My latest work</a>}
      {github && <a class="btn-alt" href={github.href} rel="me noopener">GitHub ↗</a>}
    </div>
  </section>

  {showcase.length > 0 && (
    <ul class="grid">
      {showcase.map((p) => <li><ProjectCard project={p} /></li>)}
    </ul>
  )}
  <p class="more"><a href={url('/projects')}>All projects →</a></p>

  <h2 class="sect-head">By the numbers<a href={url('/about')}>More →</a></h2>
  <Stats compact />

  {latest.length > 0 && (
    <>
      <h2 class="sect-head">Journey<a href={url('/timeline')}>Full timeline →</a></h2>
      <ol class="rail home-rail">
        {latest.map((item) => <TimelineEntry item={item} />)}
      </ol>
    </>
  )}
</Base>
