---
import Base from '../layouts/Base.astro';
import Stats from '../components/Stats.astro';
import { site } from '../data/site';
// The About text lives in Markdown so it's easy to rewrite as you change.
import { Content } from '../data/about.md';
---

<Base title="About">
  <article class="prose">
    <h1>About</h1>
    {site.now && <p class="now">Now: {site.now}</p>}
    <div class="body">
      <Content />
    </div>

    <h2 class="sect-head" style="margin-top:2.5rem">By the numbers</h2>
    <Stats />

    {(site.email || site.links.length > 0) && (
      <>
        <h2 style="margin-top:2.5rem">Find me</h2>
        <ul class="find-me">
          {site.email && <li><a class="btn" href={`mailto:${site.email}`}>Email</a></li>}
          {site.links.map((l) => <li><a class="btn ghost" href={l.href} rel="me noopener">{l.label} ↗</a></li>)}
        </ul>
      </>
    )}
  </article>
</Base>
