---
import Base from '../../layouts/Base.astro';
import ProjectCard from '../../components/ProjectCard.astro';
import CategoryNav from '../../components/CategoryNav.astro';
import { categoryKeys, type Category } from '../../lib/categories';
import { getProjects, getArchive } from '../../lib/content';
import { url } from '../../lib/url';

const projects = await getProjects();
const archiveCount = (await getArchive()).length;
const counts = Object.fromEntries(
  categoryKeys.map((k) => [k, projects.filter((p) => p.data.category === k).length]),
) as Record<Category, number>;
---

<Base title="Projects" description="Everything I've built, newest first.">
  <h1>Projects</h1>
  <p class="lede">Everything I've built, newest first.</p>

  <CategoryNav current="all" counts={counts} total={projects.length} />

  {projects.length === 0
    ? <p>Nothing here yet. Add a Markdown file to <code>src/content/projects/</code>.</p>
    : (
      <ul class="grid">
        {projects.map((p) => <li><ProjectCard project={p} /></li>)}
      </ul>
    )}

  {archiveCount > 0 && (
    <p class="archive-note muted">
      Older builds and experiments live in the <a href={url('/projects/archive')}>archive</a>.
    </p>
  )}
</Base>
