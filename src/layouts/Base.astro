---
import '@fontsource-variable/manrope'; // self-hosted font for headings: no request to Google
import '../styles/global.css';
import { site, nav } from '../data/site';
import { url } from '../lib/url';

interface Props {
  title?: string;
  description?: string;
}

const { title, description = site.tagline } = Astro.props;
const pageTitle = title ? `${title} · ${site.name}` : site.name;
const initial = site.name.trim().charAt(0).toUpperCase() || '·';

// Mark the current section in the nav (works with or without a base path).
const trim = (p: string) => p.replace(/\/$/, '') || '/';
const home = trim(url('/'));
const here = trim(Astro.url.pathname);
const isCurrent = (href: string) => {
  const h = trim(url(href));
  return h === home ? here === home : here === h || here.startsWith(`${h}/`);
};

// Footer date is the build date, so it refreshes on every deploy.
const updated = new Date().toISOString().slice(0, 10);
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{pageTitle}</title>
    <meta name="description" content={description} />
    <meta name="theme-color" content="#f9f9f9" media="(prefers-color-scheme: light)" />
    <meta name="theme-color" content="#161616" media="(prefers-color-scheme: dark)" />
    <link rel="icon" type="image/svg+xml" href={url('/favicon.svg')} />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <!-- Apply a saved theme before the page paints, so there is no flash of the wrong one. -->
    <script is:inline>
      try {
        var saved = localStorage.getItem('theme');
        if (saved === 'light' || saved === 'dark') document.documentElement.dataset.theme = saved;
      } catch (e) {}
    </script>
  </head>
  <body>
    <a class="skip" href="#main">Skip to content</a>
    <header class="site-header">
      <div class="wrap">
        <a class="brand" href={url('/')} aria-label={`${site.name}, home`}><span class="brand-mark" aria-hidden="true">{initial}</span></a>
        <nav aria-label="Main">
          <ul>
            {nav.map((item) => (
              <li>
                <a href={url(item.href)} aria-current={isCurrent(item.href) ? 'page' : undefined}>
                  {item.label}
                </a>
              </li>
            ))}
          </ul>
        </nav>
        <div class="head-right">
          <button class="theme-toggle" type="button" aria-label="Switch between light and dark">
            <svg class="sun" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" aria-hidden="true"><circle cx="12" cy="12" r="4.2"/><path d="M12 2.5v2.3M12 19.2v2.3M2.5 12h2.3M19.2 12h2.3M5.3 5.3l1.6 1.6M17.1 17.1l1.6 1.6M18.7 5.3l-1.6 1.6M6.9 17.1l-1.6 1.6"/></svg>
            <svg class="moon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M20 14.5A8.5 8.5 0 0 1 9.5 4a8.5 8.5 0 1 0 10.5 10.5z"/></svg>
          </button>
        </div>
      </div>
    </header>

    <main id="main">
      <div class="wrap">
        <slot />
      </div>
    </main>

    <footer class="site-footer">
      <div class="wrap foot-grid">
        <div class="foot-brand">
          <a class="brand" href={url('/')}><span class="brand-mark" aria-hidden="true">{initial}</span>{site.name}</a>
          <p>{site.tagline}</p>
          <small>© {new Date().getFullYear()} {site.name} · Last updated {updated}</small>
        </div>
        <div>
          <p class="foot-h">Links</p>
          <ul>
            {nav.map((item) => <li><a href={url(item.href)}>{item.label}</a></li>)}
            <li><a href={url('/projects/archive')}>Archive</a></li>
          </ul>
        </div>
        <div>
          <p class="foot-h">Elsewhere</p>
          <ul>
            {site.email && <li><a href={`mailto:${site.email}`}>Email</a></li>}
            {site.links.map((l) => <li><a href={l.href} rel="me noopener">{l.label} ↗</a></li>)}
          </ul>
        </div>
      </div>
    </footer>

    <script>
      // Header button: flip between light and dark, and remember the choice on this device.
      const root = document.documentElement;
      const button = document.querySelector<HTMLButtonElement>('.theme-toggle');
      const current = () => root.dataset.theme ?? (matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light');
      button?.addEventListener('click', () => {
        const next = current() === 'dark' ? 'light' : 'dark';
        root.dataset.theme = next;
        try { localStorage.setItem('theme', next); } catch {}
      });
    </script>
  </body>
</html>
